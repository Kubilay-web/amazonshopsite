// Amazon Clone - Prisma schema (MongoDB)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum BannerPosition {
  HERO
  STRIP
}

// ---------------------------------------------------------------- composites

type ProductColor {
  name String
  hex  String
}

type CartItem {
  productId       String
  slug            String
  title           String
  image           String
  price           Float
  discountPercent Int    @default(0)
  qty             Int
  size            String?
  color           String?
  stock           Int    @default(0)
}

type OrderItem {
  productId String
  slug      String
  title     String
  image     String
  price     Float // unit price actually charged (after discount)
  qty       Int
  size      String?
  color     String?
}

type ShippingAddress {
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
}

// ------------------------------------------------------------------- models

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  image     String?
  phone     String?
  blocked   Boolean   @default(false)
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart?
  wishlist  Wishlist[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Address {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String  @db.ObjectId
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String  @default("Türkiye")
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  slug          String        @unique
  image         String?
  order         Int           @default(0)
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("categories")
}

model SubCategory {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String    @unique
  image      String?
  categoryId String    @db.ObjectId
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String         @unique
  description     String
  details         String?
  brand           String?
  sku             String?
  images          String[]
  price           Float
  discountPercent Int            @default(0)
  stock           Int            @default(0)
  sold            Int            @default(0)
  rating          Float          @default(0)
  numReviews      Int            @default(0)
  colors          ProductColor[]
  sizes           String[]
  tags            String[]
  featured        Boolean        @default(false)
  isActive        Boolean        @default(true)
  shippingFree    Boolean        @default(false)

  categoryId    String       @db.ObjectId
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?      @db.ObjectId
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  reviews   Review[]
  wishlist  Wishlist[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model Order {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String          @unique
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  shippingAddress ShippingAddress
  paymentMethod   String          @default("stripe")
  paymentStatus   PaymentStatus   @default(UNPAID)
  stripeSessionId String?
  paymentIntentId String?
  itemsPrice      Float
  shippingPrice   Float           @default(0)
  taxPrice        Float           @default(0)
  discount        Float           @default(0)
  totalPrice      Float
  couponCode      String?
  status          OrderStatus     @default(PENDING)
  isPaid          Boolean         @default(false)
  paidAt          DateTime?
  isDelivered     Boolean         @default(false)
  deliveredAt     DateTime?
  trackingNumber  String?
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Coupon {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  code            String   @unique
  discountPercent Int
  minAmount       Float    @default(0)
  maxUses         Int      @default(0) // 0 = sınırsız
  usedCount       Int      @default(0)
  startDate       DateTime @default(now())
  endDate         DateTime
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("coupons")
}

model Banner {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  subtitle  String?
  image     String
  link      String         @default("/")
  position  BannerPosition @default(HERO)
  order     Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("banners")
}

/// Mağazanın tek satırlık yapılandırması (key = "site").
/// Yönetim panelindeki "Ayarlar" ekranı bu kaydı düzenler.
model Setting {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique @default("site")

  // Kimlik
  siteName        String @default("amazon")
  siteDescription String @default("Milyonlarca üründe uygun fiyat ve hızlı teslimat.")
  supportEmail    String @default("")
  supportPhone    String @default("")
  contactAddress  String @default("")

  // Duyuru şeridi
  announcement       String  @default("")
  announcementLink   String  @default("/")
  announcementActive Boolean @default(false)

  // Ticaret kuralları
  freeShippingLimit Float @default(50)
  shippingCost      Float @default(4.99)
  taxRate           Float @default(0)
  minOrderAmount    Float @default(0)
  lowStockThreshold Int   @default(5)

  // Anahtarlar
  codEnabled       Boolean @default(true)
  stripeEnabled    Boolean @default(true)
  reviewsEnabled   Boolean @default(true)
  registrationOpen Boolean @default(true)

  // Bakım modu
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("Mağazamız kısa bir bakım çalışması nedeniyle geçici olarak kapalı.")

  // Sosyal medya
  facebook  String @default("")
  instagram String @default("")
  twitter   String @default("")
  youtube   String @default("")

  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Yönetici işlemlerinin izlenebilir kaydı.
model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  userName  String   @default("")
  userEmail String   @default("")
  action    String // CREATE | UPDATE | DELETE | BULK | LOGIN
  entity    String // product | order | user | setting …
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@map("auditlogs")
}

/// Mağazadaki her sayfa görüntülemesinin anonim kaydı.
/// Kişisel veri tutulmaz: IP saklanmaz, `visitorId` günlük değişen tek yönlü
/// bir özettir (IP + tarayıcı + tarih + gizli anahtar). Ertesi gün aynı
/// ziyaretçi farklı bir kimlik alır, dolayısıyla kalıcı takip yapılmaz.
model PageView {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Nereye
  path  String
  title String @default("")

  // Kim (anonim)
  visitorId String
  sessionId String  @default("")
  userId    String? @db.ObjectId

  // Nereden
  referrer String @default("")
  source   String @default("direct") // google, instagram, example.com, direct …
  medium   String @default("none") // organic | social | referral | cpc | none
  campaign String @default("")

  // Nerede
  country String @default("") // ISO-2 (TR, DE …)
  city    String @default("")

  // Ne ile
  device   String @default("desktop") // desktop | mobile | tablet
  browser  String @default("")
  os       String @default("")
  language String @default("")

  // Ne zaman — `date` ve `hour` Europe/Istanbul saatine göre önceden
  // hesaplanır; böylece raporlar saat dilimi çevirisi yapmadan gruplanabilir.
  date      String // YYYY-MM-DD
  hour      Int    @default(0) // 0-23
  createdAt DateTime @default(now())

  @@index([date])
  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
  @@map("pageviews")
}
